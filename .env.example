# Use Neon's pooled connection string (hostname contains -pooler) for app traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Optional: direct (non-pooled) Neon connection for Alembic migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require
APP_ENV=development
SESSION_DAYS=30
AUTO_CREATE_TABLES=false
# Optional: override the default frontend build directory.
FRONTEND_DIST=./frontend/dist
